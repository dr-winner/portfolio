# Copy to `.env` and fill in values. Never commit `.env`.

# Prisma: Postgres everywhere (Neon in production).
# Keep schema=portfolio. The app strips that param for the pg driver and sets search_path=portfolio.
# An EMPTY value in production means every DB write fails silently: the public site falls back to
# seed content, but waitlist/telemetry/admin break.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&schema=portfolio"

# Admin session signing secret. MUST be 32+ chars: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Unlisted editor path. 24 hex characters: openssl rand -hex 12
# /admin and /studio always return 404.
ADMIN_PATH=""

# Password sign-in stays until LEGACY_PASSWORD_LOGIN=false.
# Use 24+ chars: openssl rand -hex 24
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# LEGACY_PASSWORD_LOGIN="true"

# Required for the analytics hash. No fallback.
ANALYTICS_SALT=""

# GitHub API: private contributions graph on the site (optional).
# GITHUB_TOKEN="ghp_..."

# Site console / terminal AI replies (optional; without it, local commands only).
# GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"

# Analytics fingerprinting salt (optional; falls back to SESSION_SECRET).
# ANALYTICS_SALT=""

# Optional https URL for the CV when public/cv.pdf is not in the repo.
# /cv.pdf redirects here. Leave empty and the CV page explains that the file is not published yet.
# CV_PDF_URL=""

# Extra browser origins allowed to call /api/terminal and /api/telemetry, comma separated.
# The request's own host is always allowed. Missing Origin is rejected.
# ALLOWED_ORIGINS=""

# Vercel Blob: admin image uploads in production (auto-set when a Blob store is linked to the project).
# Without it, uploads fall back to public/uploads (local dev only; ephemeral on Vercel).
# BLOB_READ_WRITE_TOKEN=""
