# Copy to `.env` and fill in values. Never commit `.env`.

# Prisma — Postgres everywhere (Neon in production; schema=portfolio isolates this app's tables).
# An EMPTY value in production means every DB write fails silently: the public site falls back to
# seed content, but waitlist/telemetry/admin break.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&schema=portfolio"

# Admin session (HMAC cookie). MUST be 32+ chars — generate with: openssl rand -hex 32
# An empty/short value makes sign-in fail even with the right password.
SESSION_SECRET="change-me-to-a-long-random-string"

# Admin login — plain password, compared in constant time server-side.
# Use 12+ chars: openssl rand -base64 15
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# GitHub API — private contributions graph on the site (optional).
# GITHUB_TOKEN="ghp_..."

# Site console / terminal AI replies (optional; without it, local commands only).
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"

# Analytics fingerprinting salt (optional; falls back to SESSION_SECRET).
# ANALYTICS_SALT=""

# Vercel Blob — admin image uploads in production (auto-set when a Blob store is linked to the project).
# Without it, uploads fall back to public/uploads (local dev only; ephemeral on Vercel).
# BLOB_READ_WRITE_TOKEN=""
